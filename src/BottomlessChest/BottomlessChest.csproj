<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>BottomlessChest</AssemblyName>
    <RootNamespace>BottomlessChest</RootNamespace>
    <Version>0.2.0</Version>
    <LangVersion>latest</LangVersion>
    <!-- Valheim's Mono runtime resolves these itself; do not copy them next to us. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <!-- Unity/BepInEx assemblies are not deterministic-friendly; keep restore quiet. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game assemblies we need private members of. -->
  <ItemGroup>
    <Reference Include="$(ValheimManaged)\assembly_valheim.dll" Publicize="true" Private="false" />
    <Reference Include="$(ValheimManaged)\assembly_utils.dll" Publicize="true" Private="false" />
    <Reference Include="$(ValheimManaged)\assembly_guiutils.dll" Publicize="true" Private="false" />
    <!-- 1.0 moved save-storage types here; FileHelpers now takes a CloudStorageFileGrouping. -->
    <Reference Include="$(ValheimManaged)\Splatform.dll" Private="false" />
    <!-- GuiInputField: Valheim's TMP_InputField, which unlike the legacy one raises focus events. -->
    <Reference Include="$(ValheimManaged)\gui_framework.dll" Private="false" />
  </ItemGroup>

  <!-- Unity engine assemblies. Referenced wholesale: cheap, and it avoids a rebuild
       every time we touch a new Unity subsystem. None are copied to output. -->
  <ItemGroup>
    <UnityAssembly Include="$(ValheimManaged)\UnityEngine*.dll" />
    <UnityAssembly Include="$(ValheimManaged)\Unity.TextMeshPro.dll" />
    <Reference Include="@(UnityAssembly)" Private="false" />
  </ItemGroup>

  <!-- Loader and library. Both are supplied at runtime by the r2modman profile. -->
  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(JotunnDir)\Jotunn.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BottomlessChest.Logic\BottomlessChest.Logic.csproj" />
  </ItemGroup>

  <!-- SkipDeploy lets a packaging build run without touching live installs. -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true' AND '$(DeployDir)' != '' AND Exists('$(R2_PROFILE)')">
    <MakeDir Directories="$(DeployDir)" />
    <!-- Retries="0": while Valheim is running it holds a mapped section on the DLL and the
         copy can never succeed, so retrying just buries the real reason in warnings. -->
    <Copy SourceFiles="$(TargetPath);$(TargetDir)BottomlessChest.Logic.dll"
          DestinationFolder="$(DeployDir)" Retries="0" ContinueOnError="true">
      <Output TaskParameter="CopiedFiles" ItemName="_DeployedFiles" />
    </Copy>
    <Message Condition="'@(_DeployedFiles)' != ''" Importance="high" Text="Deployed $(AssemblyName).dll -> $(DeployDir)" />
    <Warning Condition="'@(_DeployedFiles)' == ''" Code="BC0001"
             Text="DEPLOY SKIPPED - Valheim is running and holds the plugin DLL. Quit the game, then rebuild." />

    <!-- Mirror to the dedicated server if BepInEx has been set up there. Skipped silently
         when it has not, so a client-only machine builds without noise. -->
    <MakeDir Condition="Exists('$(SERVER_INSTALL)\BepInEx\plugins')" Directories="$(ServerDeployDir)" />
    <Copy Condition="Exists('$(SERVER_INSTALL)\BepInEx\plugins')"
          SourceFiles="$(TargetPath);$(TargetDir)BottomlessChest.Logic.dll"
          DestinationFolder="$(ServerDeployDir)" Retries="0" ContinueOnError="true">
      <Output TaskParameter="CopiedFiles" ItemName="_ServerDeployed" />
    </Copy>
    <Message Condition="'@(_ServerDeployed)' != ''" Importance="high" Text="Deployed to dedicated server -> $(ServerDeployDir)" />
    <!-- Silence here would let client and server drift apart unnoticed, which is exactly
         what the dual deploy exists to prevent. -->
    <Warning Condition="Exists('$(SERVER_INSTALL)\BepInEx\plugins') AND '@(_ServerDeployed)' == ''" Code="BC0002"
             Text="SERVER DEPLOY SKIPPED - the dedicated server is running and holds the DLL. Ctrl+C it, then rebuild, or client and server will be on different builds." />
  </Target>

</Project>
